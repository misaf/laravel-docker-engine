{
    "name": "misaf/laravel-docker-engine",
    "description": "Laravel integration for the misaf/docker-engine-php SDK with Docker and Podman driver management.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "laravel",
        "laravel-package",
        "docker-engine-php",
        "container",
        "docker-engine",
        "docker",
        "podman",
        "oci",
        "devops"
    ],
    "authors": [
        {
            "name": "Ehsan Mahmoodi",
            "email": "misaf.1990@gmail.com",
            "role": "Developer"
        }
    ],
    "homepage": "https://github.com/misaf/laravel-docker-engine",
    "support": {
        "issues": "https://github.com/misaf/laravel-docker-engine/issues",
        "source": "https://github.com/misaf/laravel-docker-engine"
    },
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "misaf/docker-engine-php": "^1.0@dev",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "larastan/larastan": "^3.10",
        "laravel/boost": "^2.5",
        "laravel/pint": "^1.3",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^5.1",
        "pestphp/pest-plugin-arch": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-profanity": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0",
        "phpstan/extension-installer": "^1.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Misaf\\LaravelDockerEngine\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Misaf\\LaravelDockerEngine\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Misaf\\LaravelDockerEngine\\Providers\\ContainerServiceProvider"
            ]
        }
    },
    "scripts": {
        "analyse": "@php -d memory_limit=1G vendor/bin/phpstan analyse",
        "format": "vendor/bin/pint",
        "test": "@php -d memory_limit=1G vendor/bin/pest",
        "test-coverage": "@php -d memory_limit=1G vendor/bin/pest --coverage"
    },
    "$schema": "https://getcomposer.org/schema.json"
}
